strip.text.x    = element_blank(),     # pair_type labels live on the top strip, not repeated here
strip.text.y    = element_markdown(size=14),  # high / low on the right
legend.position = "bottom"
)
# ---- stack two plots, aligned by the pair_type columns, one shared legend ----
p1 <- p_dist2 +
theme(plot.tag.position = c(0, 1.02))
p_combined <- p_combined <- p1 / p_main2 +
plot_layout(heights = c(1, 3), guides = "collect") +
plot_annotation(tag_levels = "A") &
theme(legend.position = "bottom") &
theme(
legend.position = "bottom",
axis.title.x = element_text(size = 15),   # x-labs: "Block" + "Probability of option A"
axis.title.y = element_text(size = 15),   # y-labs: "P(A option chosen)" + "Number of participants"
legend.title = element_text(size = 14),
legend.text  = element_text(size = 13),
plot.tag     = element_text(size = 16, face = "bold")
)
p_combined
# A (recommended): matched 10-trial window in both conditions
edge_A <- df_learning_bin |>
filter(pair %in% c("A80", "A90")) |>
group_by(id, pair) |>
slice_max(bin, n = 2, with_ties = FALSE) |>
summarise(k = sum(k), n = sum(n), .groups = "drop") |>
mutate(prop_A = k / n)
# B (sensitivity): all plateau bins — 20: bins 3-4; 40: bins 5-8
edge_B <- df_learning_bin |>
filter(pair %in% c("A80", "A90"),
(condition == "20" & bin >= 3) | (condition == "40" & bin >= 5)) |>
group_by(id, pair) |>
summarise(k = sum(k), n = sum(n), .groups = "drop") |>
mutate(prop_A = k / n)
get_ids <- function(d) {
d |> group_by(id) |>
summarise(n_edge = n(), n_pass = sum(prop_A > 0.5), .groups = "drop") |>
filter(n_edge == 2, n_pass == 2) |> pull(id)
}
ids_A <- get_ids(edge_A); ids_B <- get_ids(edge_B)
# compare retention by condition — this is the diagnostic that matters
df_learning2 |> distinct(id, condition) |>
mutate(A = id %in% ids_A, B = id %in% ids_B) |>
group_by(condition) |>
summarise(n = n(), kept_A = sum(A), kept_B = sum(B),
pct_A = mean(A), pct_B = mean(B))
# --- Robustness subsample: participants with satisfactory learning -----------
# Criterion: over the LAST 10 learning trials for each edge pair (the final two
# 5-trial bins), the participant predicted event A on more than half of trials.
# Both edge pairs must pass.
# The 10-trial window is matched across conditions (20-trial: bins 3-4;
# 40-trial: bins 7-8) so the criterion is equally reliable in both groups,
# and both windows fall inside the learning plateau.
edge_final <- df_learning_bin |>
filter(pair %in% c("A80", "A90")) |>
group_by(id, pair) |>
slice_max(bin, n = 2, with_ties = FALSE) |>      # final two bins for that pair
summarise(k = sum(k), n = sum(n), .groups = "drop") |>
mutate(prop_A = k / n)                            # proportion over 10 trials
# sanity checks
stopifnot(all(edge_final$n == 10))                  # 10 trials per pair
stopifnot(all(table(edge_final$id) == 2))           # both edge pairs per person
included_ids <- edge_final |>
group_by(id) |>
summarise(n_edge = n(),                           # must be 2 (A80 and A90)
n_pass = sum(prop_A > 0.5),
.groups = "drop") |>
filter(n_edge == 2, n_pass == 2) |>
pull(id)
length(included_ids)
# retention by condition — report these numbers, and check they're comparable
df_learning2 |>
distinct(id, condition) |>
mutate(kept = id %in% included_ids) |>
group_by(condition) |>
summarise(n_total = n(), n_kept = sum(kept),
pct_kept = round(mean(kept), 3), .groups = "drop")
# sensitivity: stricter threshold, same window
ids_strict <- edge_final |>
group_by(id) |>
summarise(n_edge = n(), n_pass = sum(prop_A > 0.6), .groups = "drop") |>
filter(n_edge == 2, n_pass == 2) |>
pull(id)
length(ids_strict)
# apply to judgment-phase data
df_judgment_sub <- df_judgment |> filter(id %in% included_ids)
